{
  "name": "startapus-browser",
  "version": "0.24.0",
  "description": "Startapus Browser — a real <webview> browser tab in the DSH right sidebar with agent tools (read page, act, screenshot, verify) and a DOM element picker.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "react": ">=18.2.0 <19"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react-icons": "5.4.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "selftest": "node build.mjs && node scripts/check-scripts.mjs && node scripts/check-rules.mjs && node scripts/check-engine.mjs && node scripts/check-client-imports.mjs && node scripts/check-client-apply.mjs && node scripts/check-tools.mjs && node scripts/selftest.mjs",
    "live": "node scripts/live-check.mjs",
    "check-scripts": "node scripts/check-scripts.mjs",
    "check-apply": "node scripts/check-client-apply.mjs",
    "check-rules": "node scripts/check-rules.mjs",
    "check-engine": "node scripts/check-engine.mjs",
    "check-imports": "node scripts/check-client-imports.mjs",
    "check-tools": "node scripts/check-tools.mjs",
    "gate": "npm run selftest && echo GATE OK",
    "gate:live": "npm run gate && node scripts/live-check.mjs",
    "soak": "node scripts/soak.mjs",
    "soak:short": "node scripts/soak.mjs --minutes=2",
    "market": "node scripts/market-pack.mjs"
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Startupus-Team/DSH_start_browser.git"
  },
  "homepage": "https://github.com/Startupus-Team/DSH_start_browser",
  "bugs": {
    "url": "https://github.com/Startupus-Team/DSH_start_browser/issues"
  },
  "author": "Startupus Team"
}
